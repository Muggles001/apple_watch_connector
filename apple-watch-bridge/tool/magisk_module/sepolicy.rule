# The root helper runs only after an explicit in-app action and remains in
# the root manager's domain: magisk under Magisk, su under KernelSU. It talks
# to the standard Bluetooth HCI service, over binder (AIDL) or hwbinder
# (HIDL); the callback rules permit controller events and ACL data to return.
allow magisk hal_bluetooth_service service_manager find
allow magisk hal_bluetooth_hwservice hwservice_manager find
allow magisk hal_bluetooth_server binder { call transfer }
allow magisk hal_bluetooth_default binder { call transfer }
allow hal_bluetooth_server magisk binder { call transfer }
allow hal_bluetooth_default magisk binder { call transfer }
allow hal_bluetooth_server magisk fd use
allow hal_bluetooth_default magisk fd use
allow su hal_bluetooth_service service_manager find
allow su hal_bluetooth_hwservice hwservice_manager find
allow su hal_bluetooth_server binder { call transfer }
allow su hal_bluetooth_default binder { call transfer }
allow hal_bluetooth_server su binder { call transfer }
allow hal_bluetooth_default su binder { call transfer }
allow hal_bluetooth_server su fd use
allow hal_bluetooth_default su fd use
